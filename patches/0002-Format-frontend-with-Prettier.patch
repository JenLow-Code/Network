+import React, { useState } from 'react';
+import { Image, View, StyleSheet, Text } from 'react-native';
+import Svg, { Defs, LinearGradient, Stop, Rect, Path, Circle } from 'react-native-svg';
+export function OfflineDreamImage({
+  uri,
+  height = 190,
+  label = 'Dream image',
+  radius = 12,
+}: {
+  uri?: string;
+  height?: number;
+  label?: string;
+  radius?: number;
+}) {
+  const [failed, setFailed] = useState(false);
+  return (
+    <View style={{ height, borderRadius: radius, overflow: 'hidden', backgroundColor: '#e8e9e7' }}>
+      <Svg width="100%" height="100%" viewBox="0 0 320 190" preserveAspectRatio="xMidYMid slice">
+        <Defs>
+          <LinearGradient id="offlineGradient" x1="0" x2="1" y1="0" y2="1">
