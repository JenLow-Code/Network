+      if (alive) {
+        setSession(next);
+        setInitialized(true);
+      }
+    });
+    void supabase.auth
+      .getSession()
+      .then(({ data, error }) => {
+        if (alive) {
+          setSession(error ? null : data.session);
+          setInitialized(true);
+        }
+      })
+      .catch(() => {
+        if (alive) {
+          setInitialized(true);
+          setSession(null);
+        }
+      });
+    return () => {
+      alive = false;
+      sub.data.subscription.unsubscribe();
+    };
+  }, []);
+  const actions = useMemo<AuthContext>(
+    () => ({
+      user: session?.user ?? null,
+      session,
+      initialized,
+      configured: authConfigured,
