+export function pickFlowerMedia(
+  onSelected: (files: DreamMedia[]) => void,
+  onError: (message: string) => void,
+) {
+  if (Platform.OS !== 'web') {
+    onError(
+      'La sélection des fichiers sur Android/iOS sera disponible avec le module média natif.',
