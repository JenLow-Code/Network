+            <Stop offset="1" stopColor="#e7d5de" />
+          </LinearGradient>
+        </Defs>
+        <Rect width="320" height="190" fill="url(#offlineGradient)" />
+        <Circle cx="246" cy="43" r="26" fill="#ffffff" opacity=".45" />
+        <Path
