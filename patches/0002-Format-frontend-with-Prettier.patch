+        ) : null}
+        {raw ? (
+          <Text selectable style={{ fontSize: 13, lineHeight: 20, color: '#333', marginTop: 15 }}>
+            {raw}
+          </Text>
+        ) : null}
+        {ref ? (
+          <Text style={{ marginTop: 17, fontSize: 14, fontWeight: '700' }}>
+            Psaume {ref.chapter}:{ref.verse}
+          </Text>
+        ) : (
+          <Text style={{ marginTop: 20, fontSize: 12, color: '#888' }}>
+            Référence non détectée. Une étape de confirmation manuelle sera ajoutée avec la Bible
+            complète.
+          </Text>
+        )}
+        {ref?.chapter === 150 ? (
+          <Pressable
+            onPress={() => {
+              clearSharedPayloads();
+              router.replace({
+                pathname: '/bible/[reference]',
+                params: { reference: 'psalm-150', verse: String(ref.verse) },
+              });
+            }}
+            style={{
+              marginTop: 21,
+              padding: 14,
+              backgroundColor: '#111',
+              borderRadius: 9,
+              alignItems: 'center',
+            }}
+          >
+            <Text style={{ color: '#fff' }}>Ouvrir le Psaume 150 dans JenLow</Text>
+          </Pressable>
+        ) : null}
+        {ref && ref.chapter !== 150 ? (
+          <Text style={{ fontSize: 12, color: '#888', marginTop: 13 }}>
+            Cette référence nécessite l'importation du texte biblique complet. Elle n'est pas
+            remplacée par un autre chapitre.
+          </Text>
+        ) : null}
+        <Text style={{ marginTop: 28, color: '#aaa', fontSize: 11 }}>
+          Le texte ou l'image partagés restent soumis aux droits de leur source. JenLow affichera
+          une édition légalement réutilisable lorsque la bibliothèque complète sera connectée.
+        </Text>
+      </ScrollView>
+      <Nav />
+    </SafeAreaView>
+  );
 }
