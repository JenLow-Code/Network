# Supabase Auth only (no service_role, no D1 credentials)
# Create a free Supabase project, then use Project Connect > Project URL and publishable key.
EXPO_PUBLIC_SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_PUBLIC_KEY
# The existing Cloudflare Worker remains the JenLow application API.
EXPO_PUBLIC_API_URL=https://jenlow-network-auth.jenlow-production.workers.dev
