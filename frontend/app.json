{
  "expo": {
    "name": "JenLow Network",
    "slug": "jenlow-network",
    "scheme": "jenlownetwork",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain",
              "image/*"
            ],
            "multipleShareMimeTypes": []
          }
        }
      ],
      "expo-web-browser",
      "expo-audio"
    ],
    "web": {
      "bundler": "metro",
      "name": "JenLow Network",
      "favicon": "./assets/images/network-icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jenlow.network"
    },
    "android": {
      "package": "com.jenlow.network",
      "icon": "./assets/images/network-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/network-icon.png",
        "backgroundColor": "#FFFCF5"
      }
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "com.jenlow.network.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.jenlow.network"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "cdfe03a8-44c2-449d-8789-166e2eae7359"
      }
    },
    "icon": "./assets/images/network-icon.png"
  }
}
