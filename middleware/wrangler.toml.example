# Isolated staging only. Do not use production database or signing secret.
name = "jenlow-network-security-staging"
main = "src/index.ts"
compatibility_date = "2026-10-25"
compatibility_flags = ["nodejs_compat"]
workers_dev = true
[vars]
ENVIRONMENT = "staging"
ALLOWED_ORIGIN = "http://localhost:8081"
[[d1_databases]]
binding = "DB"
database_name = "network-security-staging"
database_id = "REPLACE_WITH_STAGING_DATABASE_ID"
migrations_dir = "../database/migrations"
[triggers]
crons = ["*/15 * * * *"]
