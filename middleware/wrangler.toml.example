# Deployment configuration for the free-tier beta API.
# Copy to wrangler.toml; keep credentials in Cloudflare secret bindings.
name = "jenlow-network-auth"
main = "src/worker-runtime.js"
compatibility_date = "2026-10-25"
workers_dev = true

[vars]
ALLOWED_ORIGIN = "https://network.jenlow.net,https://network.jenlow-production.workers.dev"

[[d1_databases]]
binding = "DB"
database_name = "network"
database_id = "62ca4199-a913-4444-b176-b5d18c8817d1"
migrations_dir = "../database/migrations"
