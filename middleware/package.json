{
  "name": "@jenlow/network-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "bundle:check": "esbuild src/index.ts --bundle --format=esm --platform=neutral --external:node:crypto --outfile=dist/worker.check.js --log-level=warning",
    "seed:sql": "tsx scripts/build-seed.ts",
    "db:migrate:local": "wrangler d1 migrations apply network --local",
    "db:migrate:remote": "wrangler d1 migrations apply network --remote",
    "db:seed:local": "wrangler d1 execute network --local --file=../database/seeds/demo_seed.sql",
    "db:seed:remote": "wrangler d1 execute network --remote --file=../database/seeds/demo_seed.sql",
    "openapi": "tsx scripts/write-openapi.ts",
    "coverage:routes": "tsx scripts/route-coverage.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "wrangler": "^4.46.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
